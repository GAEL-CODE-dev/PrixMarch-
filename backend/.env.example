# Copie ce fichier en .env, puis renseigne JWT_SECRET (32 caractères minimum).
# Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Développement uniquement : désactive les limites de requêtes
# RATE_LIMIT=off

# Derrière un proxy (Render, etc.)
# TRUST_PROXY=1

# Origines autorisées pour l'interface (séparées par des virgules).
# Mets * pour tout autoriser (déconseillé en production).
CORS_ORIGIN=http://localhost:5173

# development | production | test
# En production, CORS_ORIGIN est obligatoire et * est refusé.
NODE_ENV=development
