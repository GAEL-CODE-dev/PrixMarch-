# Copie ce fichier en .env, puis renseigne JWT_SECRET (32 caractères minimum).
# Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Développement uniquement : désactive les limites de requêtes
# RATE_LIMIT=off

# Derrière un proxy (Render, Railway, Nginx...) : nombre de proxies de confiance.
# Obligatoire en production, sinon tous les visiteurs partagent la même IP et
# les limites de requêtes bloquent le monde entier.
# TRUST_PROXY=1

# Origines autorisées pour l'interface (séparées par des virgules).
# Laisse vide si l'interface est servie par l'API (même origine).
# Mets * pour tout autoriser (refusé en production).
CORS_ORIGIN=http://localhost:5173

# Emplacement de la base SQLite. En production, pointe-le vers le disque
# persistant fourni par l'hébergeur (ex. /var/data/prixmarche.db).
# DB_PATH=

# Insère les marchés et produits de base au démarrage s'ils manquent.
# À activer sur un volume neuf (jamais avec --demo en production).
# SEED_ON_START=true

# development | production | test
# En production : * est refusé ; CORS_ORIGIN vide = même origine uniquement.
NODE_ENV=development
